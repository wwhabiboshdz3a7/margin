# Firebase web app config (Project settings → Your apps → Web app).
# Enable "Firebase AI Logic" with the Gemini Developer API in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud model used when on-device inference is unavailable (or when you pick "Cloud").
VITE_CLOUD_MODEL=gemini-3.5-flash

# App Check (required by Firebase AI Logic).
# Production: a reCAPTCHA Enterprise site key registered in App Check.
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Local runs / judging: a debug token registered under App Check → Apps → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
